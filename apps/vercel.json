{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs"
    },

    "api": {
      "root": "apps/api",
      "framework": "express"
    }
  },

  "rewrites": [
    {
      "source": "/auth/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/tasks",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/tasks/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/agent/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/health",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}