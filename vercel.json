{
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs"
    },
    "api": {
      "root": "apps/api",
      "framework": "express",
      "entrypoint": "src/server.ts"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api",
        "path": "/api/$1"
      }
    },
    {
      "source": "/auth/(.*)",
      "destination": {
        "service": "api",
        "path": "/auth/$1"
      }
    },
    {
      "source": "/tasks/(.*)",
      "destination": {
        "service": "api",
        "path": "/tasks/$1"
      }
    },
    {
      "source": "/tasks",
      "destination": {
        "service": "api",
        "path": "/tasks"
      }
    },
    {
      "source": "/health",
      "destination": {
        "service": "api",
        "path": "/health"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}